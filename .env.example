# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=your-database-url
DIRECT_URL=your-direct-url

# OAuth (Mercado Pago)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY_SAAS=your-mercadopago-public-key
MERCADOPAGO_ACCESS_TOKEN_SAAS=your-mercadopago-access-token

# OAuth (Mercado Pago) - Conectar cuenta del negocio
MERCADOPAGO_OAUTH_CLIENT_ID=your-mercadopago-app-id
MERCADOPAGO_OAUTH_CLIENT_SECRET=your-mercadopago-client-secret
# Optional: if omitted, defaults to `${NEXT_PUBLIC_SITE_URL}/api/mercadopago/oauth/callback`
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:3000/api/mercadopago/oauth/callback
# Solo next dev: tras OAuth MP, a dónde vuelve el navegador (cookies Supabase). Por defecto http://localhost:3000.
# Si probás 100% por ngrok en el mismo navegador, poné tu URL ngrok aquí.
# MERCADOPAGO_OAUTH_BROWSER_RETURN_ORIGIN=http://localhost:3000

# Webhook (Mercado Pago)
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret
# Optional: if true, invalid signatures return 401. For QR flows, MP may not be verifiable; keep false.
MERCADOPAGO_WEBHOOK_ENFORCE_SIGNATURE=false

