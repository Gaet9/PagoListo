# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# URL pública canónica (sin barra final). En producción usar el host final (p. ej. https://www.pagolisto.com.ar)
# si el apex redirige: MP notification_url/IPN suele no seguir redirects y el webhook no llega a Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=your-database-url
DIRECT_URL=your-direct-url

# Mercado Pago — app «SaaS / abono» (Checkout Pro con token global de la plataforma).
# NO usar estas credenciales para OAuth de tiendas (vincular cuenta del comercio).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY_SAAS=your-mercadopago-public-key
MERCADOPAGO_ACCESS_TOKEN_SAAS=your-mercadopago-access-token
# Abono SaaS PagoListo (precio solo servidor; Checkout Pro con token global)
# Precio mensual en ARS (solo servidor). Cualquier entero positivo; 100 es válido en QA/sandbox.
PAGOLISTO_SAAS_PLAN_MENSUAL_ARS=100
PAGOLISTO_SAAS_PLAN_MENSUAL_TITLE=PagoListo — Abono mensual
# Paywall Mi tienda: false solo en dev local; en producción omitir o usar true
PAGOLISTO_SUBSCRIPTION_ENFORCE=true
# Cancelación: estado en suscripciones_usuario (canceled_at + status); acceso hasta current_period_end.
# Checkout SaaS: POST /api/mercadopago/saas/preference → webhook /api/mercadopago/webhook activa el abono.
# Cancelar: POST /api/subscription/cancel (sesión autenticada).

# Mercado Pago — app «OAuth / cobro tienda» (vincular cuenta del vendedor por negocio).
# Client ID = número de aplicación en Developers (no es la Public Key del SaaS).
# Misma app donde registrás Redirect URI y (si aplica) PKCE en el panel.
MERCADOPAGO_OAUTH_CLIENT_ID=your-mercadopago-app-id
MERCADOPAGO_OAUTH_CLIENT_SECRET=your-mercadopago-client-secret
# Optional: if omitted, defaults to `${NEXT_PUBLIC_SITE_URL}/api/mercadopago/oauth/callback` (sin barra final; debe coincidir con el panel MP)
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:3000/api/mercadopago/oauth/callback
# Producción: NEXT_PUBLIC_SITE_URL=https://www.pagolisto.com.ar — ver docs/mercadopago-oauth-ops.md
# Solo next dev: tras OAuth MP, a dónde vuelve el navegador (cookies Supabase). Por defecto http://localhost:3000.
# Si probás 100% por ngrok en el mismo navegador, poné tu URL ngrok aquí.
# MERCADOPAGO_OAUTH_BROWSER_RETURN_ORIGIN=http://localhost:3000

# Webhook (Mercado Pago) — tienda + abono SaaS usan POST/GET /api/mercadopago/webhook
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret
# Debe coincidir con la clave en MP → Tu integración → Webhooks → Configurar notificaciones (modo producción).
# Checkout Pro también envía IPN GET ?topic=payment&id=… y Webhooks POST ?data.id=…&type=payment hacia notification_url.
# Por defecto se rechazan notificaciones sin x-signature (401). Con query data.id, firma inválida → 401.
# Preferencia notification_url sin data.id: se procesa tras GET /v1/payments/{id} (MP no valida firma en esa URL).
# Solo para IPN/QR sin firma y sin data.id: MERCADOPAGO_WEBHOOK_ALLOW_UNSIGNED=true
# MERCADOPAGO_WEBHOOK_ALLOW_UNSIGNED=true
# Deuda ops (evitar en prod): MERCADOPAGO_WEBHOOK_ENFORCE_SIGNATURE=false permite IPN sin x-signature.
# Preferir quitar esa variable (default seguro) una vez MP panel + notification_url apunten al host canónico.
# MERCADOPAGO_WEBHOOK_ENFORCE_SIGNATURE=false

# Resend (correo transaccional desde la app; Auth/recuperación de contraseña puede usar SMTP de Resend en Supabase por separado)
RESEND_API_KEY=re_your-resend-api-key
# Remitente en producción (obligatorio; dominio verificado en Resend). En dev/test sin esta variable se usa onboarding@resend.dev.
RESEND_FROM=hola@pagolisto.com.ar

