# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=your-database-url
DIRECT_URL=your-direct-url

# MercadoPago OAuth (Connect)
MERCADOPAGO_APP_ID=your-mercadopago-app-id
MERCADOPAGO_CLIENT_SECRET=your-mercadopago-client-secret
# Must match the Redirect URL configured in MercadoPago app settings
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/mercadopago/callback
# Random secret for signing OAuth state (CSRF protection)
MERCADOPAGO_OAUTH_STATE_SECRET=change-me-with-a-long-random-string